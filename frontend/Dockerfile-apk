FROM ghcr.io/cirruslabs/flutter:stable AS builder
WORKDIR /app

COPY pubspec.* ./
RUN flutter pub get

COPY . .
RUN dart run build_runner build && \
    chmod +x tool/compute-version.sh tool/build-apk-manifest.sh

ARG APP_FLAVOR=production
ARG VERSION_NAME
ARG VERSION_CODE
ENV APP_FLAVOR=${APP_FLAVOR}
ENV VERSION_NAME=${VERSION_NAME}
ENV VERSION_CODE=${VERSION_CODE}
RUN bash -c '. tool/compute-version.sh && \
    flutter build apk --release --flavor ${FLAVOR} \
      --build-name=${VERSION_NAME} --build-number=${VERSION_CODE} && \
    mkdir -p /tmp/artifacts && \
    APK=build/app/outputs/flutter-apk/app-${FLAVOR}-release.apk && \
    cp "$APK" /tmp/artifacts/scoutbox-v${VERSION_NAME}-${VERSION_CODE}.apk && \
    tool/build-apk-manifest.sh \
      build/app/outputs/flutter-apk \
      "${VERSION_NAME}" "${VERSION_CODE}" \
      /tmp/artifacts'

FROM nginx:alpine
RUN rm -f /usr/share/nginx/html/index.html
COPY nginx/apk.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /tmp/artifacts/ /usr/share/nginx/html/
EXPOSE 80
