---
<!doctype html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Télécharger ScoutBox</title>
<style>
:root {
  --bg: oklch(98.5% 0.002 240);
  --surface: oklch(100% 0 0);
  --fg: oklch(18% 0.018 250);
  --muted: oklch(48% 0.014 250);
  --border: oklch(90% 0.006 250);
  --accent: #186a23;
  --accent-hover: #14521c;
  --accent-soft: oklch(94% 0.04 145);
  --font-display: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', system-ui, sans-serif;
  --font-body:   -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', system-ui, sans-serif;
  --font-mono:   ui-monospace, 'JetBrains Mono', 'SF Mono', Menlo, monospace;
  --radius: 14px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--font-body);
  font-size: 15px;
  color: var(--fg);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  min-height: 100dvh;
}

a { color: inherit; text-decoration: none; }

.page {
  max-width: 780px;
  margin: 0 auto;
  padding: 64px 20px 80px;
}
@media (min-width: 768px) {
  .page { padding: 100px 32px 120px; }
}

.hero {
  display: flex; flex-direction: column; align-items: center;
  text-align: center;
  padding-bottom: 64px;
}

.hero-logo {
  width: 88px; height: 88px;
  border-radius: 20px;
  overflow: hidden;
  margin-bottom: 28px;
}
.hero-logo svg, .hero-logo img { width: 100%; height: 100%; display: block; }

.hero h1 {
  font-family: var(--font-display);
  font-size: 40px;
  font-weight: 700;
  letter-spacing: -0.025em;
  line-height: 1.1;
}

.hero .tagline {
  font-size: 17px;
  color: var(--muted);
  max-width: 400px;
  line-height: 1.5;
  margin-top: 12px;
}

.hero .version {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--muted);
  margin-top: 16px;
}

.btn-group {
  display: flex; gap: 10px; align-items: center; flex-wrap: wrap; justify-content: center;
  margin-top: 28px;
}

.btn-download {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 15px 32px;
  border-radius: var(--radius);
  background: var(--accent);
  color: var(--surface);
  font-size: 15px; font-weight: 590;
  cursor: pointer; border: none;
  transition: background 0.12s, transform 0.1s;
  white-space: nowrap;
}
.btn-download:hover { background: var(--accent-hover); }
.btn-download:active { transform: scale(0.97); }
.btn-download svg { width: 20px; height: 20px; flex-shrink: 0; }

.btn-web {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 14px 28px;
  border-radius: var(--radius);
  background: var(--surface);
  color: var(--fg);
  border: 1px solid var(--border);
  font-size: 15px; font-weight: 590;
  cursor: pointer;
  transition: background 0.12s, border-color 0.12s;
  white-space: nowrap;
}
.btn-web:hover { background: oklch(97% 0.002 250); border-color: var(--muted); }
.btn-web svg { width: 18px; height: 18px; flex-shrink: 0; }

.features {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
  padding: 56px 0 0;
  border-top: 1px solid var(--border);
}

.feature-item {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}

.fi-icon {
  width: 22px; height: 22px;
  flex-shrink: 0;
  margin-top: 2px;
  color: var(--accent);
}
.fi-icon svg { width: 100%; height: 100%; display: block; }

.fi-text h3 {
  font-size: 16px; font-weight: 600;
  color: var(--fg);
  margin-bottom: 4px;
}
.fi-text p {
  font-size: 14px; color: var(--muted);
  line-height: 1.55;
  max-width: 52ch;
}

@media (min-width: 600px) {
  .features {
    grid-template-columns: 1fr 1fr;
    gap: 36px 48px;
  }
}

.page-footer {
  margin-top: 72px;
  padding-top: 24px;
  border-top: 1px solid var(--border);
  text-align: center;
  font-size: 12px; color: var(--muted);
}
</style>
</head>
<body>
<slot />
</body>
</html>
