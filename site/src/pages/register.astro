---
const webAppUrl = import.meta.env.PUBLIC_WEB_APP_URL;
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ScoutBox — Invitation</title>
<style>
:root {
  --bg: oklch(98.5% 0.002 240);
  --surface: oklch(100% 0 0);
  --fg: oklch(18% 0.018 250);
  --muted: oklch(48% 0.014 250);
  --border: oklch(90% 0.006 250);
  --accent: #186a23;
  --accent-hover: #14521c;
  --accent-soft: oklch(94% 0.04 145);
  --font-display: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', system-ui, sans-serif;
  --font-body:   -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', system-ui, sans-serif;
  --font-mono:   ui-monospace, 'JetBrains Mono', 'SF Mono', Menlo, monospace;
  --radius: 14px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--font-body);
  font-size: 15px;
  color: var(--fg);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  min-height: 100dvh;
}

a { color: inherit; text-decoration: none; }

body.redirecting .page-content { visibility: hidden; }

.page {
  max-width: 640px;
  margin: 0 auto;
  padding: 64px 20px 80px;
}
@media (min-width: 768px) {
  .page { padding: 80px 32px 100px; }
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding-bottom: 40px;
}

.logo {
  width: 72px; height: 72px;
  border-radius: 18px;
  overflow: hidden;
  margin-bottom: 20px;
}
.logo svg, .logo img { width: 100%; height: 100%; display: block; }

.header h1 {
  font-family: var(--font-display);
  font-size: 30px;
  font-weight: 700;
  letter-spacing: -0.02em;
}
.header .subtitle {
  font-size: 15px;
  color: var(--muted);
  margin-top: 8px;
  line-height: 1.5;
  max-width: 420px;
}

.btn-group {
  display: flex;
  flex-direction: column;
  gap: 10px;
  align-items: stretch;
  margin-top: 24px;
}
@media (min-width: 480px) {
  .btn-group { flex-direction: row; align-items: center; }
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 28px;
  border-radius: var(--radius);
  background: var(--accent);
  color: var(--surface);
  font-size: 15px; font-weight: 590;
  cursor: pointer; border: none;
  transition: background 0.12s, transform 0.1s;
  flex: 1;
}
.btn-primary:hover { background: var(--accent-hover); }
.btn-primary:active { transform: scale(0.97); }

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 28px;
  border-radius: var(--radius);
  background: var(--surface);
  color: var(--fg);
  border: 1px solid var(--border);
  font-size: 15px; font-weight: 590;
  cursor: pointer;
  transition: background 0.12s, border-color 0.12s;
  flex: 1;
}
.btn-secondary:hover { background: oklch(97% 0.002 250); border-color: var(--muted); }

.manual {
  margin-top: 32px;
  padding: 20px;
  border-radius: var(--radius);
  background: var(--surface);
  border: 1px solid var(--border);
}

.manual-label {
  font-size: 13px;
  color: var(--muted);
  margin-bottom: 4px;
}
.manual-value {
  font-family: var(--font-mono);
  font-size: 15px;
  color: var(--fg);
  word-break: break-all;
  margin-bottom: 12px;
}
.manual-value:last-child { margin-bottom: 0; }

.warning {
  margin-top: 20px;
  font-size: 13px;
  color: var(--muted);
  line-height: 1.5;
}

.download-link {
  display: block;
  margin-top: 24px;
  text-align: center;
  font-size: 13px;
  color: var(--accent);
  text-decoration: underline;
}
.download-link:hover { color: var(--accent-hover); }

.error-message {
  text-align: center;
  padding: 40px 20px;
  color: var(--muted);
  font-size: 16px;
}

.page-footer {
  margin-top: 48px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
  text-align: center;
  font-size: 12px;
  color: var(--muted);
}
</style>
<script is:inline define:vars={{ webAppUrl }}>
  (function() {
    var params = new URLSearchParams(window.location.search);
    var server = params.get('server');
    var invite = params.get('invite');

    if (!server || !invite) {
      document.getElementById('error-state').style.display = 'block';
      return;
    }

    var deepLink = 'scoutbox://register?server=' + encodeURIComponent(server) + '&invite=' + encodeURIComponent(invite);
    var webUrl = webAppUrl + '?server=' + encodeURIComponent(server) + '&invite=' + encodeURIComponent(invite);

    document.getElementById('open-app-btn').href = deepLink;
    document.getElementById('open-web-btn').href = webUrl;
    document.getElementById('manual-server').textContent = server;
    document.getElementById('manual-code').textContent = invite;
    document.getElementById('normal-state').style.display = 'block';

    if (/Android/i.test(navigator.userAgent)) {
      document.body.classList.add('redirecting');
      window.location.href = deepLink;

      setTimeout(function() {
        document.body.classList.remove('redirecting');
      }, 2500);
    }
  })();
</script>
</head>
<body>

<div class="page">
  <div class="page-content">

    <div id="error-state" style="display:none">
      <div class="header">
        <div class="logo" aria-label="ScoutBox">
          <img src="/brand/logo.svg" alt="ScoutBox" />
        </div>
        <h1>ScoutBox</h1>
        <p class="subtitle">Lien d'invitation incomplet.</p>
      </div>
      <p class="error-message">
        Le lien que vous avez ouvert ne contient pas toutes les informations nécessaires.<br>
        Demandez à la personne qui vous a invité de vous renvoyer le lien.
      </p>
      <a class="download-link" href="/">Télécharger ScoutBox</a>
    </div>

    <div id="normal-state" style="display:none">
      <div class="header">
        <div class="logo" aria-label="ScoutBox">
          <img src="/brand/logo.svg" alt="ScoutBox" />
        </div>
        <h1>ScoutBox</h1>
        <p class="subtitle">Vous avez été invité à rejoindre Scoutbox</p>
      </div>

      <div class="btn-group">
        <a id="open-app-btn" class="btn-primary" href="#">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
            <line x1="12" y1="18" x2="12.01" y2="18"></line>
          </svg>
          Ouvrir dans l'application
        </a>
        <a id="open-web-btn" class="btn-secondary" href="#">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          Continuer dans le navigateur
        </a>
      </div>

      <div class="manual">
        <p class="manual-label">URL du serveur</p>
        <p class="manual-value" id="manual-server">—</p>
        <p class="manual-label">Code d'invitation</p>
        <p class="manual-value" id="manual-code">—</p>
      </div>

      <p class="warning">
        Attention, le code d'invitation ne peut être utilisé qu'une seule fois et expire au bout de 30 jours.
      </p>

      <a class="download-link" href="/">Télécharger l'application</a>
    </div>

    <footer class="page-footer">ScoutBox · Fabriqué avec ❤️ par Pierre-Antoine Chéron</footer>

  </div>
</div>

</body>
</html>
